# Copiá este archivo como .env.local (está en .gitignore: nunca se sube a GitHub).
# En Vercel, estas mismas variables se cargan en Settings → Environment Variables.

# Tu base en MongoDB Atlas (Connect → Drivers). Reemplazá <password> por la contraseña del usuario de la base.
MONGODB_URI=mongodb+srv://usuario:password@tu-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Nombre de la base dentro del cluster (opcional, por defecto "gastos"). Ej.: gastos_pruebas para probar.
MONGODB_DB=gastos

# Login del administrador. Sin ADMIN_PASSWORD, en tu compu (npm run dev) no se pide login;
# publicada sin contraseña, la app se bloquea sola.
ADMIN_PASSWORD=
# Al menos 32 caracteres al azar. Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
