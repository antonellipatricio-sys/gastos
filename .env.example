# Copiá este archivo como .env.local para probar el login en tu compu (opcional).
# En Vercel, estas mismas variables se cargan en Settings → Environment Variables.

# Base de datos. Sin esto se usa el archivo local data/gastos.db.
# Para Turso: la URL que da `turso db show gastos --url` y el token de `turso db tokens create gastos`.
DATABASE_URL=libsql://gastos-tuusuario.turso.io
DATABASE_AUTH_TOKEN=

# Login del administrador. Sin ADMIN_PASSWORD, en tu compu (npm run dev) no se pide login;
# publicada sin contraseña, la app se bloquea sola.
ADMIN_PASSWORD=
# Al menos 32 caracteres al azar. Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
